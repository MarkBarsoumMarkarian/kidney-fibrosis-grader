# Streamlit secrets — copy this file and fill in your keys.
# When deploying to Streamlit Cloud, add these under Settings → Secrets.
# For local development, place this file at .streamlit/secrets.toml
# (already in .gitignore — do NOT commit real keys).

# Required — LLM nephropathology report (Llama 4 Scout via Groq)
# Get a free key at https://console.groq.com
GROQ_API_KEY = "your_groq_api_key_here"

# Optional — IF panel safety review (Gemma 4 31B via OpenRouter)
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY = "your_openrouter_api_key_here"
